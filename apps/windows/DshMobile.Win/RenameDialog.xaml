<Window x:Class="DshMobile.Win.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DshMobile.Win.Resources"
        Title="{x:Static res:Strings.Rename_Title}" Height="300" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Border Margin="6" Background="{DynamicResource CardElevatedBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="14">
        <Border.Effect>
            <DynamicResource ResourceKey="CardShadow" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="16,10,10,8">
                <TextBlock Text="{x:Static res:Strings.Rename_Title}" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center" />
                <Button Width="40" Height="40" MinWidth="36" MinHeight="36"
                        HorizontalAlignment="Right" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="{x:Static res:Strings.Common_Close}" Click="Cancel_Click"
                        AutomationProperties.Name="{x:Static res:Strings.Common_Close}">
                    <Path Data="M6 6l12 12M18 6L6 18" Width="14" Height="14" Stretch="Uniform"
                          Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Height="1" Background="{DynamicResource OutlineBrush}" />

            <StackPanel Grid.Row="2" Margin="16,12,16,12">
                <TextBlock Text="{x:Static res:Strings.Rename_Prompt}" FontSize="13"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBox x:Name="NameBox" Margin="0,10,0,0" Height="40"
                         MaxLength="32"
                         ToolTip="{x:Static res:Strings.Rename_InputTooltip}" />
                <TextBlock Margin="0,8,0,0" FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="{x:Static res:Strings.Rename_Note}" />
                <StackPanel Margin="0,14,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="80" Content="{x:Static res:Strings.Common_Cancel}" Click="Cancel_Click" />
                    <Button Width="80" Margin="8,0,0,0" Content="{x:Static res:Strings.Rename_Save}"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
