<Application x:Class="DshMobile.Win.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- =====================================================================
             Semantic tokens (light values live here; the dark set replaces the
             whole brush list in App.ApplyDarkPalette).

             MASTER.md's table still owns the base roles (background, card,
             primary/secondary text, accent, border, error). The extra surface
             tokens below exist because the desktop client has more layers than a
             phone screen: a navigation rail, a page header band, group cards and
             row dividers. Every one of them is a DynamicResource reference, so
             ApplyDarkPalette/ApplyLightPalette repaint the window in place.
             ===================================================================== -->

        <!-- Surfaces -->
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardElevatedBrush" Color="#FFFFFF" />
        <!-- These are design-time defaults; App.xaml.cs installs the runtime palette at
             startup and its values win.
             Border and divider tokens are deliberately hairlines (about 1.2:1 on white), not
             the >=1.6:1 used before the neutral redesign: grouping is carried by the canvas
             step, the way Apple's settings panels do it, and a card that needs more
             separation should raise its shadow rather than darken its outline. The old
             #C6CCD6 frame read as a drawn box. See design-system/dsh-mobile/MASTER.md. -->
        <SolidColorBrush x:Key="CardBorderBrush" Color="#E8E8ED" />
        <SolidColorBrush x:Key="RailBrush" Color="#FDFDFF" />
        <SolidColorBrush x:Key="RailBorderBrush" Color="#E8EBF2" />
        <SolidColorBrush x:Key="SurfaceAltBrush" Color="#EDF1F7" />
        <SolidColorBrush x:Key="OutlineBrush" Color="#D9D9DE" />
        <SolidColorBrush x:Key="DividerBrush" Color="#EDEDF0" />

        <!-- Text -->
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#85858B" />

        <!-- Accent -->
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
        <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FF" />
        <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#D6E2FB" />
        <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

        <!-- Interaction -->
        <SolidColorBrush x:Key="HoverBrush" Color="#F1F4F9" />
        <SolidColorBrush x:Key="PressedBrush" Color="#E6EBF2" />
        <SolidColorBrush x:Key="SwitchKnobBrush" Color="#FFFFFF" />

        <!-- Disabled controls: a real fill/border/text triple instead of the old
             45% opacity fade, which left white text on pale blue at ~1.8:1 (the
             "连接中" cards). Text is 3.8:1 on the fill, border 1.8:1. -->
        <SolidColorBrush x:Key="DisabledFillBrush" Color="#E6EBF2" />
        <SolidColorBrush x:Key="DisabledBorderBrush" Color="#A7B3C4" />
        <SolidColorBrush x:Key="DisabledTextBrush" Color="#6B7789" />

        <!-- Status -->
        <SolidColorBrush x:Key="ErrorBrush" Color="#B91C1C" />
        <SolidColorBrush x:Key="SuccessBrush" Color="#15803D" />
        <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />

        <!-- Scrollbar. 1.7:1 thumb on the page surface; the old #D8DEE7
             measured 1.27:1 and read as no scrollbar at all. -->
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#B8C2D1" />
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9AA5B8" />

        <!-- =====================================================================
             Type and depth
             ===================================================================== -->

        <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>
        <!-- Latin display text through Segoe UI Variable; Chinese falls back to
             YaHei UI, so mixed strings keep one optical weight. -->
        <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Microsoft YaHei UI</FontFamily>

        <DropShadowEffect x:Key="CardShadow" Color="#0B1220" BlurRadius="20"
                          ShadowDepth="2" Direction="270" Opacity="0.05"
                          RenderingBias="Quality" />

        <!-- =====================================================================
             Vector glyphs, 24x24 viewbox, 1.6 stroke. MASTER.md forbids emoji in
             product controls: these follow the accent/secondary tokens and draw
             identically on every Windows build.
             ===================================================================== -->
        <Geometry x:Key="IcoPalette">M4 5.5h16v13H4z M4 15l4.5-4.5 3.5 3.5 3-3 5 5 M8.2 8.4a1 1 0 1 0 .01 0</Geometry>
        <Geometry x:Key="IcoTheme">M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z M12 3v2 M12 19v2 M5.6 5.6l1.4 1.4 M17 17l1.4 1.4 M3 12h2 M19 12h2 M5.6 18.4l1.4-1.4 M17 7l1.4-1.4</Geometry>
        <Geometry x:Key="IcoPower">M12 3.2v8.6 M7.1 6.1a7 7 0 1 0 9.8 0</Geometry>
        <Geometry x:Key="IcoBell">M12 4.2a5.4 5.4 0 0 0-5.4 5.4c0 3.9-1.4 5-1.4 5h13.6s-1.4-1.1-1.4-5A5.4 5.4 0 0 0 12 4.2Z M10.3 18.6a1.9 1.9 0 0 0 3.4 0</Geometry>
        <Geometry x:Key="IcoBroom">M4.5 7h15 M9.5 7V4.4h5V7 M6.4 7l1 12.6h9.2l1-12.6 M10.4 11v5 M13.6 11v5</Geometry>
        <Geometry x:Key="IcoInfo">M12 3.4a8.6 8.6 0 1 0 0 17.2 8.6 8.6 0 0 0 0-17.2Z M12 11v5 M12 8v.01</Geometry>
        <Geometry x:Key="IcoChevron">M14.4 6.2 8.6 12l5.8 5.8</Geometry>
        <Geometry x:Key="IcoNavDevices">M4 6h16M4 12h16M4 18h10</Geometry>
        <Geometry x:Key="IcoNavSettings">M12 15.5A3.5 3.5 0 1 0 12 8.5a3.5 3.5 0 0 0 0 7Z M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4.1a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4 1.7 1.7 0 0 0-1.6 0Z</Geometry>

        <!-- FocusVisualStyle used where the template cannot draw the ring itself:
             the system TextBox template and the pairing-panel styles local to
             MainWindow.xaml. Controls whose template this file owns draw the ring
             in-template on IsKeyboardFocused instead (see the Button style), which
             is the sibling path that keeps the ring independent of the adorner
             layer. -->
        <Style x:Key="FocusRing" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="-3" RadiusX="8" RadiusY="8"
                                   Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Font only. The default colour is set on each window's root via
             TextElement.Foreground: a Foreground setter here outranks inheritance, which
             silently defeated every control template that colours its own label (the
             primary button, the segmented choice, the danger menu item). -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        </Style>

        <!-- =====================================================================
             Typography scale
             ===================================================================== -->

        <!-- Page header: small Latin eyebrow above the Chinese display title. -->
        <Style x:Key="EyebrowText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="DisplayTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
        <Style x:Key="PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Secondary, not muted: a row hint explains what the setting does ("the same 10
             icons as the phone app"), so it has to be readable. MutedBrush measures about
             3.7:1 and is reserved for decoration. -->
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>

        <!-- =====================================================================
             Surfaces
             ===================================================================== -->

        <!-- One card per setting group, not one card per setting: rows inside are
             separated by a hairline, so a group reads as a list instead of a pile
             of identical boxes. -->
        <Style x:Key="GroupCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderGradientBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <!-- DynamicResource: App.xaml.cs replaces CardShadow when the theme changes, and
                 a StaticResource would keep the shadow from the first palette. -->
            <Setter Property="Effect" Value="{DynamicResource CardShadow}" />
        </Style>
        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="Margin" Value="20,0,20,0" />
        </Style>
        <!-- 36px accent-tinted glyph tile that anchors each row. -->
        <Style x:Key="IconChip" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource IconChipBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- =====================================================================
             Controls
             ===================================================================== -->

        <!-- Secondary action: 12dp radius, >=40px hit area, calm hover/press colors.
             Only the brush changes - layout never shifts (MASTER.md shape/motion).

             Focus is drawn inside the template by an overlay ring on
             IsKeyboardFocused, not through FocusVisualStyle: the adorner ring was
             invisible in practice (WCAG 2.4.7 failure), and an in-template trigger
             is the same signal every other state uses. The overlay sits in a Grid
             cell of the same size, so showing it never reflows the button. -->
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="MinWidth" Value="72" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <!-- Filled, not outlined: on a white card a white button with a grey border is
                 just a drawn rectangle. A soft fill separates it without a line. -->
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="9"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusOutline" CornerRadius="9" BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Disabled reads as a disabled control with legible text
                                 (3.8:1) instead of a 45% opacity fade. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action: 16dp radius, accent fill, larger hit area. -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
            <Setter Property="Background" Value="{DynamicResource PrimaryButtonBrush}" />
            <!-- No outline: a border darker than its own fill reads as a black edge. Depth
                 comes from the vertical gradient, the way a filled Apple button does it. -->
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <!-- On an accent fill the ring has to be the on-accent
                                 colour, otherwise it is blue on blue. -->
                            <Border x:Name="FocusOutline" CornerRadius="10" BorderThickness="2"
                                    BorderBrush="{DynamicResource OnAccentBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Disabled (the "连接中" cards): the old 0.45 opacity
                                 left white text on pale blue at ~1.8:1. A muted fill,
                                 a visible border and 3.8:1 text replace it. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource DisabledFillBrush}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Borderless page-level action ("return to devices"). -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Root" Background="Transparent" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusOutline" CornerRadius="8" BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Navigation rail destination: glyph over a short label. The 60x54 hit
             area keeps the desktop rail comfortable without widening the column. -->
        <Style x:Key="RailItem" TargetType="RadioButton">
            <Setter Property="Width" Value="60" />
            <Setter Property="Height" Value="54" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="12">
                            <Grid>
                                <!-- 3px marker, drawn just outside the pill so the
                                     active destination stays visible at a glance. -->
                                <Border x:Name="Marker" Width="3" Height="20" CornerRadius="1.5"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="-4,0,0,0"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path x:Name="Glyph"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          Stroke="{TemplateBinding Foreground}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" />
                                    <TextBlock x:Name="Caption" Text="{TemplateBinding Content}"
                                               FontFamily="{StaticResource UiFont}"
                                               FontSize="10.5" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"
                                               Foreground="{TemplateBinding Foreground}" />
                                </StackPanel>
                                <Border x:Name="FocusOutline" CornerRadius="12" BorderThickness="2"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented choice: one shared track with a raised selected pill. The
             segmented control used to be three separate outlined boxes, which read
             as three unrelated buttons. -->
        <Style x:Key="SegmentTrack" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Language drop-down. Eight options do not fit a segmented control, so this is a
             drop-down sized like its neighbours: 32 DIP tall, 10px radius, centred in the row.
             The ToggleButton is what opens the list — a ComboBox template without one cannot
             be opened at all. Focus is drawn in-template for the same reason as every other
             control here. -->
        <Style x:Key="LangPicker" TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="9"
                                    Background="{DynamicResource SurfaceAltBrush}"
                                    BorderBrush="Transparent"
                                    BorderThickness="1">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter VerticalAlignment="Center"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      TextElement.Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <Path Grid.Column="1" Margin="10,1,0,0" Data="M5 8l5 5 5-5"
                                          Width="10" Height="6" Stretch="Uniform"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" VerticalAlignment="Center"
                                          Stroke="{DynamicResource SecondaryTextBrush}" />
                                </Grid>
                            </Border>
                            <!-- Transparent hit layer: this is what opens the list. -->
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="FocusOutline" CornerRadius="9" BorderThickness="1.5"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                            <Popup x:Name="PART_Popup" AllowsTransparency="True"
                                   Placement="Bottom" VerticalOffset="4"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border CornerRadius="9" MinWidth="{TemplateBinding ActualWidth}"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                        Margin="0,0,8,10">
                                    <!-- The shell's own raised-layer shadow, not a hard-coded
                                         black one: it is theme-aware and already tuned for
                                         the surface scale (MASTER.md: restrained shadows). -->
                                    <Border.Effect>
                                        <DynamicResource ResourceKey="CardShadow" />
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"
                                                  MaxHeight="300">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="LangPickerItem" TargetType="ComboBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" CornerRadius="6" Margin="4,1" Padding="9,7"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegChoice" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Border x:Name="Root" CornerRadius="7" Padding="{TemplateBinding Padding}"
                                    Background="Transparent">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <Border x:Name="FocusOutline" CornerRadius="7" BorderThickness="2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Visibility="Collapsed" IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- A selected segment is accent-filled: draw the ring in
                                 the on-accent colour so it is not blue on blue. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boolean row switch. 44x24 track, 16px knob; the knob travels inside a
             fixed-size track, so toggling never reflows the row. -->
        <Style x:Key="SwitchToggle" TargetType="CheckBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid>
                                <Border x:Name="Track" Width="44" Height="24" CornerRadius="12"
                                        Background="{DynamicResource PressedBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                    <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                            Background="{DynamicResource SwitchKnobBrush}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="3,0,0,0" />
                                </Border>
                                <Border x:Name="FocusOutline" Width="44" Height="24" CornerRadius="12"
                                        BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                                        Visibility="Collapsed" IsHitTestVisible="False"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource OnAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SecondaryTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsKeyboardFocused" Value="True" />
                                    <Condition Property="IsChecked" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource OnAccentBrush}" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin overlay scrollbar: the stock WPF scrollbar (17px, arrow buttons)
             is the loudest default control left in the shell. -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Root" CornerRadius="3" Margin="1,0"
                                Background="{DynamicResource ScrollThumbBrush}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True"
                                   Orientation="{TemplateBinding Orientation}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand"
                                                  Focusable="False" IsTabStop="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand"
                                                  Focusable="False" IsTabStop="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False"
                                           Orientation="{TemplateBinding Orientation}">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand"
                                                          Focusable="False" IsTabStop="False" Opacity="0" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand"
                                                          Focusable="False" IsTabStop="False" Opacity="0" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- No vertical padding: the text view clips glyphs when given vertical
                 padding (measured: 7px glyph band at 40px height). Center it instead. -->
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <!-- System template on purpose: a custom rounded template clipped the
                 text view to a 6px band at 40px height (measured), while the system
                 template renders the same box fully. Square corners are the trade. -->
        </Style>

        <!-- =====================================================================
             Overlays: context menu, menu items, separators, tool tips

             WPF ships these with SystemColors: a #F0F0F0 menu behind #F2F5F9 text
             (measured 1.04:1 - the dark-mode "⋯" menu was white on white) and a
             pale yellow tool tip, neither of which belongs to a token-based card
             UI. Every brush here is a DynamicResource, so the light/dark swap in
             App.ApplyDarkPalette repaints an open menu and later tool tips too.
             ===================================================================== -->

        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The header colours through TemplateBinding Foreground, so a caller can
             mark a destructive item red with item.SetResourceReference(
             ForegroundProperty, "ErrorBrush") - the pixel the default template
             ignored (MainWindow.Devices.cs's 删除（可撤销）). -->
        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,4" />
            <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                Effect="{DynamicResource CardShadow}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
