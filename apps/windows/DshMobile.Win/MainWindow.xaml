<Window x:Class="DshMobile.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:DshMobile.Win.Resources"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DeepSeek Harness" Height="760" Width="1280"
        MinHeight="520" MinWidth="520"
        Icon="/app.ico"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <!-- Vector icons. MASTER.md forbids emoji in product controls: they depend on
             the font, cannot follow tokens, and render differently per platform. These
             are 24px path glyphs with a 1.6 stroke, so one visual weight throughout. -->
        <Geometry x:Key="IconDevices">M4 6h16M4 12h16M4 18h10</Geometry>
        <Geometry x:Key="IconSettings">M12 15.5A3.5 3.5 0 1 0 12 8.5a3.5 3.5 0 0 0 0 7Z M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-2.9 1.2 2 2 0 1 1-4 0 1.7 1.7 0 0 0-2.9-1.2l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1A1.7 1.7 0 0 0 3 15a2 2 0 1 1 0-4 1.7 1.7 0 0 0 1.2-2.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1A1.7 1.7 0 0 0 10 4.1a2 2 0 1 1 4 0 1.7 1.7 0 0 0 2.9 1.2l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1A1.7 1.7 0 0 0 21 11a2 2 0 1 1 0 4 1.7 1.7 0 0 0-1.6 0Z</Geometry>
        <Geometry x:Key="IconBack">M15 19l-7-7 7-7</Geometry>
        <Geometry x:Key="IconPlus">M12 5v14M5 12h14</Geometry>

        <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Destructive action in a device card: same geometry as a secondary button,
             error-coloured text and border. A token reference, never a literal colour,
             so it follows the light/dark palette like everything else. -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
        </Style>

        <!-- Undo strip after deleting a paired computer. Sits above the page content on
             the adorner-free overlay layer; only its Visibility changes, so it never
             reflows the list behind it. -->
        <Style x:Key="UndoBarShell" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Visibility" Value="Collapsed" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid x:Name="BrowserPage">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="BrowserBar" Grid.Row="0" Height="38"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
                    <Grid Margin="12,0">
                        <Button x:Name="BackButton" HorizontalAlignment="Left" MinWidth="88"
                                Style="{StaticResource BarButton}"
                                Click="Back_Click"
                                ToolTip="{x:Static res:Strings.Connect_BackTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconBack}" Width="14" Height="14"
                                      Stretch="Uniform" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" VerticalAlignment="Center"
                                      Stroke="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{x:Static res:Strings.Nav_DeviceList}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="BrowserTitle" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontSize="12.5"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <Button x:Name="DisconnectButton" HorizontalAlignment="Right" MinWidth="64"
                                Style="{StaticResource BarButton}"
                                Content="{x:Static res:Strings.Connect_Disconnect}" Click="Disconnect_Click"
                                ToolTip="{x:Static res:Strings.Connect_DisconnectTooltip}" />
                    </Grid>
                </Border>
                <wv2:WebView2 x:Name="WebView" Grid.Row="1" />
            </Grid>
        </Grid>

        <!-- WebView2 owns a native HWND and ignores ZIndex, so the two pages must be
             mutually exclusive. It stays visible only until its initialisation finishes. -->
        <Grid x:Name="ConnectPage" Background="{DynamicResource AppBackgroundBrush}" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Device list page. The header (identity, page title, 添加新电脑) sits
                 outside the scroller: with a populated list that button is the only way
                 to add a computer, so scrolling the cards must not take it away. The
                 header copies the settings page structure (eyebrow, display title,
                 subtitle) instead of the old rounded brand band, so both pages read as
                 one product, and the band's card-like surface - which made a fixed
                 header look like scrolling content - is gone. The outer Grid follows the
                 scroller's Visibility, so one toggle in ShowSettingsPage still hides the
                 whole page. Styles live on this page rather than Window.Resources so the
                 two pages can evolve without sharing a dictionary. -->
            <Grid x:Name="DevicesPage" Grid.Column="0"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Visibility="{Binding Visibility, ElementName=DevicesScroll}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Fixed page header. Same 1000px column, padding, eyebrow, display title
                     and subtitle as the settings page, so the two headers are exactly the
                     same height and switching pages does not shift the content; the right
                     side carries the page action (添加新电脑), the way the settings page
                     carries its back action. No artwork in the header: the user asked for
                     no character image inside the client. -->
                <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
                    <Grid MaxWidth="1000" Margin="36,22,36,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EyebrowText}"
                                       Text="DEEPSEEK HARNESS · WINDOWS" />
                            <!-- Title and build badge share a WrapPanel: on a narrow
                                 window the badge drops under the name instead of
                                 squeezing it, so nothing clips. -->
                            <WrapPanel Margin="0,7,0,0">
                                <TextBlock Style="{StaticResource DisplayTitle}" Text="{x:Static res:Strings.Nav_Devices}"
                                           Margin="0,0,12,0" />
                                <Border VerticalAlignment="Center" CornerRadius="20"
                                        Padding="9,3" BorderThickness="1"
                                        Background="{DynamicResource CardBrush}"
                                        BorderBrush="{DynamicResource OutlineBrush}">
                                    <TextBlock x:Name="BrandVersion" FontSize="11.5"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"
                                       Text="{x:Static res:Strings.DeviceList_Subtitle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button x:Name="AddToggleButton" VerticalAlignment="Center"
                                    MinWidth="0" Padding="14,0" FontSize="12.5"
                                    Content="{x:Static res:Strings.DeviceList_AddComputer}" Click="AddToggle_Click"
                                    ToolTip="{x:Static res:Strings.DeviceList_AddToggleTooltip}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Section header, fixed with the page: "已配对电脑" is the list's
                     label and must stay with its action while the cards move. Hidden
                     while the empty state stands in for the list; the code that toggles
                     NoDevicesText drives it too. -->
                <Grid x:Name="SectionHeader" Grid.Row="1" MaxWidth="1000"
                      Margin="36,18,36,10">
                    <TextBlock Text="{x:Static res:Strings.DeviceList_PairedHeader}" Style="{StaticResource SectionTitle}"
                               Margin="0" VerticalAlignment="Center" />
                </Grid>

                <ScrollViewer x:Name="DevicesScroll" Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Loaded="DevicesPage_Loaded">
                    <ScrollViewer.Resources>
                        <!-- Stroke glyphs, not emoji (MASTER.md): they follow the token
                             colours, keep one 1.6px weight and need no icon font. -->
                        <Geometry x:Key="IconPairWifi">M3.5 9.6a13 13 0 0 1 17 0 M6.6 12.9a8.4 8.4 0 0 1 10.8 0 M9.7 16.1a3.9 3.9 0 0 1 4.6 0 M12 19.2h.01</Geometry>
                        <Geometry x:Key="IconPairGlobe">M12 3.6a8.4 8.4 0 1 0 0 16.8 8.4 8.4 0 0 0 0-16.8Z M3.9 9.4h16.2 M3.9 14.6h16.2 M12 3.6c2.5 2.4 3.7 5.2 3.7 8.4s-1.2 6-3.7 8.4c-2.5-2.4-3.7-5.2-3.7-8.4s1.2-6 3.7-8.4Z</Geometry>
                        <Geometry x:Key="IconPairLink">M9.6 14.4l4.8-4.8 M7.9 10.8 6.1 12.6a3.7 3.7 0 0 0 5.3 5.3l1.8-1.9 M16.1 13.2l1.8-1.8a3.7 3.7 0 0 0-5.3-5.3l-1.8 1.9</Geometry>
                        <Geometry x:Key="IconChevron">M9.5 6.5 15 12l-5.5 5.5</Geometry>

                        <!-- One selectable pairing method in the empty state. Only the
                             background changes on hover: the row never reflows. -->
                        <Style x:Key="MethodChoice" TargetType="Button">
                            <Setter Property="MinHeight" Value="34" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="12,7" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Root" CornerRadius="9"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Keyboard focus is an in-template ring, not a
                                                 FocusVisualStyle adorner: the adorner did not
                                                 appear when focus arrived programmatically, so
                                                 Tab through the pairing panel had no visible
                                                 stop here. Same size cell, so no reflow. -->
                                            <Border x:Name="FocusOutline" CornerRadius="9"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" IsHitTestVisible="False"
                                                    SnapsToDevicePixels="True" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Pairing-method segmented control inside the add panel: an inset
                             track, one raised segment for the current choice. -->
                        <Style x:Key="MethodTab" TargetType="RadioButton">
                            <Setter Property="MinHeight" Value="30" />
                            <Setter Property="Padding" Value="14,0" />
                            <Setter Property="FontSize" Value="12.5" />
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Grid>
                                            <Border x:Name="Root" CornerRadius="7" Margin="2"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent" BorderThickness="1"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <!-- Accent ring, not the accent fill: the checked
                                                 segment is already filled, so focus has to read
                                                 as a separate state. -->
                                            <Border x:Name="FocusOutline" CornerRadius="7" Margin="2"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" IsHitTestVisible="False"
                                                    SnapsToDevicePixels="True" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardBrush}" />
                                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource OutlineBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>

                        <!-- Text-weight action (reveal the discovery tools, show a hint):
                             no fill and no border, so it never competes with 配对并连接. -->
                        <Style x:Key="QuietAction" TargetType="Button">
                            <Setter Property="MinHeight" Value="32" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="FontSize" Value="12.5" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Grid>
                                            <Border x:Name="Root" CornerRadius="7"
                                                    Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                            </Border>
                                            <Border x:Name="FocusOutline" CornerRadius="7"
                                                    BorderThickness="2"
                                                    BorderBrush="{DynamicResource AccentBrush}"
                                                    Visibility="Collapsed" IsHitTestVisible="False"
                                                    SnapsToDevicePixels="True" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource PressedBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ScrollViewer.Resources>

                <!-- Scrolling body. The MinHeight binding keeps it at least one viewport
                     tall, so the empty state can be centred in the page instead of
                     hugging the header above a large blank area. -->
                    <Grid MinHeight="{Binding ViewportHeight, ElementName=DevicesScroll}">
                        <StackPanel x:Name="DevicesContent" Margin="36,8,36,32"
                                VerticalAlignment="Top">
                    <!-- Same measure and centring as the settings page: a left-aligned
                         820px column on a 1280-wide window left the right half empty and
                         made the two pages look like different products. -->
                            <Grid MaxWidth="1000" HorizontalAlignment="Stretch">
                                <StackPanel>

                            <!-- Connecting state: status, progress and a visible way out. Kept
                                 above the list so it is seen no matter which card was clicked. -->
                            <Border x:Name="ProgressPanel" Margin="0,16,0,0" Padding="16,14"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                     Fill="{DynamicResource AccentBrush}" />
                                            <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="13"
                                                       FontWeight="SemiBold"
                                                       AutomationProperties.LiveSetting="Polite"
                                                       AutomationProperties.Name="{x:Static res:Strings.Connect_StatusAccessibility}"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" Text="" />
                                        </StackPanel>
                                        <ProgressBar x:Name="Progress" Margin="0,10,0,0" Height="4"
                                                     IsIndeterminate="True" BorderThickness="0"
                                                     AutomationProperties.Name="{x:Static res:Strings.Connect_ProgressAccessibility}"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Background="{DynamicResource OutlineBrush}" />
                                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Hint}"
                                                   Text="{x:Static res:Strings.Connect_CancelHint}" />
                                    </StackPanel>
                                    <Button x:Name="CancelButton" Grid.Column="1" MinWidth="96"
                                            VerticalAlignment="Center"
                                            Content="{x:Static res:Strings.Connect_Cancel}" Click="Cancel_Click"
                                            ToolTip="{x:Static res:Strings.Connect_CancelTooltip}" />
                                </Grid>
                            </Border>

                            <!-- Section header lives in the fixed page header above, so the
                                 cards scroll under a label that stays put. -->
                            <StackPanel x:Name="DeviceList" />

                            <!-- Empty state. NoDevicesText keeps its name because the code-behind
                                 toggles its Visibility on every rebuild; it is a panel now, not a
                                 bare line of text. The top margin is the same 26 DIP the section
                                 header carries when a list is present: with the header collapsed
                                 the card would otherwise butt against the header's bottom border
                                 and the two rounded surfaces would read as one double rule. -->
                            <Border x:Name="NoDevicesText" Visibility="Collapsed" Padding="24,22"
                                    Margin="0,26,0,4"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="14">
                                <StackPanel>
                                    <!-- The artwork that sat left of the heading was removed
                                         on request: no character artwork inside the client. -->
                                    <TextBlock Text="{x:Static res:Strings.DeviceList_EmptyTitle}" FontSize="17"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <!-- Left-aligned on purpose: a StackPanel stretches its
                                         children, and a stretched child held back by
                                         MaxWidth is centred by WPF, which pushed this line
                                         158 DIP to the right of the title above it. -->
                                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Hint}"
                                               MaxWidth="640" HorizontalAlignment="Left"
                                               Text="{x:Static res:Strings.DeviceList_EmptyHint}" />

                                    <!-- Three ways in, each one line of what it is for. They only
                                         select the matching tab and focus the box below. Equal
                                         columns across the card's inner width, so the row belongs
                                         to the card instead of hanging off its left edge with 222
                                         DIP of empty space on the right. -->
                                    <Grid Margin="0,20,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource MethodChoice}"
                                                Tag="lan" Click="EmptyMethod_Click"
                                                AutomationProperties.Name="{x:Static res:Strings.Pairing_LanAutomationName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="{StaticResource IconPairWifi}" Width="18" Height="18"
                                                      Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{x:Static res:Strings.Channel_Lan}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Static res:Strings.Pairing_LanSummary}" Margin="0,3,0,0"
                                                               Style="{StaticResource Hint}" FontSize="11.5" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource MethodChoice}"
                                                Tag="remote" Click="EmptyMethod_Click"
                                                AutomationProperties.Name="{x:Static res:Strings.Pairing_RemoteAutomationName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="{StaticResource IconPairGlobe}" Width="18" Height="18"
                                                      Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="{x:Static res:Strings.Channel_Remote}" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Static res:Strings.Pairing_RemoteSummary}" Margin="0,3,0,0"
                                                               Style="{StaticResource Hint}" FontSize="11.5" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="4" Style="{StaticResource MethodChoice}"
                                                Tag="iroh" Click="EmptyMethod_Click"
                                                AutomationProperties.Name="{x:Static res:Strings.Pairing_IrohAutomationName}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Path Data="{StaticResource IconPairLink}" Width="18" Height="18"
                                                      Stretch="Uniform" Stroke="{DynamicResource AccentBrush}"
                                                      StrokeThickness="1.6" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Top" Margin="0,2,0,0" />
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                    <TextBlock Text="iroh" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{x:Static res:Strings.Pairing_IrohSummary}" Margin="0,3,0,0"
                                                               Style="{StaticResource Hint}" FontSize="11.5" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Pairing panel: one input, three explained methods. The two less
                                 common paths are a tab away and the discovery tools start
                                 collapsed, so the first screen is a single decision. -->
                            <Border x:Name="AddPanel" Margin="0,12,0,24" Padding="20,18"
                                    Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                                    CornerRadius="14" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.Pairing_PanelTitle}" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Hint}"
                                               Text="{x:Static res:Strings.Pairing_PanelHint}" />

                                    <Border Margin="0,14,0,0" Padding="2" CornerRadius="10"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PairModeLan" Style="{StaticResource MethodTab}"
                                                         GroupName="pairmode" Content="{x:Static res:Strings.Channel_Lan}" IsChecked="True"
                                                         Checked="PairMethod_Checked" />
                                            <RadioButton x:Name="PairModeRemote" Style="{StaticResource MethodTab}"
                                                         GroupName="pairmode" Content="{x:Static res:Strings.Channel_Remote}"
                                                         Checked="PairMethod_Checked" />
                                            <RadioButton x:Name="PairModeIroh" Style="{StaticResource MethodTab}"
                                                         GroupName="pairmode" Content="iroh"
                                                         Checked="PairMethod_Checked" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock x:Name="PairModeHint" Margin="0,12,0,0"
                                               Style="{StaticResource Hint}" TextWrapping="Wrap" />

                                    <Grid Margin="0,10,0,0">
                                        <TextBox x:Name="DescriptorBox" Height="84"
                                                 AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto"
                                                 FontFamily="Consolas" FontSize="13"
                                                 ToolTip="{x:Static res:Strings.Pairing_DescriptorTooltip}" />
                                        <TextBlock x:Name="DescriptorPlaceholder" Margin="12,9,12,0"
                                                   VerticalAlignment="Top" IsHitTestVisible="False"
                                                   FontSize="12.5" FontFamily="Microsoft YaHei UI"
                                                   Foreground="{DynamicResource SecondaryTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=DescriptorBox}"
                                                                     Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="PairButton" MinWidth="132"
                                                Style="{StaticResource PrimaryButton}"
                                                Content="{x:Static res:Strings.Pairing_ConnectAction}" Click="Pair_Click" />
                                        <Button x:Name="DiscoveryToggle" Margin="8,0,0,0"
                                                Style="{StaticResource QuietAction}"
                                                Content="{x:Static res:Strings.Pairing_FindOnThisPc}" Click="DiscoveryToggle_Click"
                                                ToolTip="{x:Static res:Strings.Pairing_FindToggleTooltip}" />
                                    </StackPanel>

                                    <!-- Advanced path, folded away until asked for. -->
                                    <Border x:Name="DiscoveryPanel" Margin="0,12,0,0" Padding="14"
                                            CornerRadius="10" Visibility="Collapsed"
                                            Background="{DynamicResource SurfaceAltBrush}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hint}"
                                                       Text="{x:Static res:Strings.Pairing_FinderHint}" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <TextBox x:Name="AddressBox" Height="32"
                                                             VerticalContentAlignment="Center"
                                                             FontFamily="Consolas" FontSize="13"
                                                             ToolTip="{x:Static res:Strings.Pairing_AddressTooltip}" />
                                                    <TextBlock x:Name="AddressPlaceholder" Margin="11,0,11,0"
                                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                                               FontSize="12.5" FontFamily="Consolas"
                                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=AddressBox}"
                                                                                 Value="">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <Button x:Name="ProbeButton" Grid.Column="1" Margin="8,0,0,0"
                                                        MinWidth="72" Content="{x:Static res:Strings.Pairing_Probe}" Click="ProbeButton_Click"
                                                        ToolTip="{x:Static res:Strings.Pairing_ProbeTooltip}" />
                                                <Button x:Name="ScanButton" Grid.Column="2" Margin="8,0,0,0"
                                                        MinWidth="96" Content="{x:Static res:Strings.Pairing_Scan}" Click="ScanButton_Click"
                                                        ToolTip="{x:Static res:Strings.Pairing_ScanTooltip}" />
                                            </Grid>
                                            <TextBlock x:Name="DiscoveryHint" Margin="0,10,0,0"
                                                       Style="{StaticResource Hint}" Visibility="Collapsed" />
                                            <StackPanel x:Name="FoundList" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Settings page. The header is outside the scroller: the product name and
                 the live icon preview stay visible while the groups move, and the whole
                 page is centered on a 1000px column instead of being pinned to the left
                 of a wide window. The outer Grid follows the scroller's Visibility so a
                 single toggle in ShowSettingsPage still hides the whole page. -->
            <Grid x:Name="SettingsPage" Grid.Column="0"
                  Visibility="{Binding Visibility, ElementName=SettingsScroll}"
                  Background="{DynamicResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="0,0,0,1">
                    <Grid MaxWidth="1000" Margin="36,22,36,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource EyebrowText}"
                                       Text="DEEPSEEK HARNESS · WINDOWS" />
                            <TextBlock Style="{StaticResource DisplayTitle}" Text="{x:Static res:Strings.Nav_Settings}"
                                       Margin="0,7,0,0" />
                            <TextBlock Style="{StaticResource PageSubtitle}" Margin="0,8,0,0"
                                       Text="{x:Static res:Strings.Settings_Subtitle}" />
                        </StackPanel>
                        <!-- Page action only: no illustration in the header. The mascot
                             artwork that used to sit here was removed on request, so the
                             header carries the way back and nothing else. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}"
                                    Click="SettingsBack_Click" ToolTip="{x:Static res:Strings.Common_BackToDeviceList}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IcoChevron}" Width="15" Height="15"
                                          Stretch="Uniform" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" VerticalAlignment="Center"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{x:Static res:Strings.Nav_DeviceList}" Margin="5,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Visibility="Collapsed">
                    <StackPanel MaxWidth="1000" MinWidth="600" Margin="36,18,36,18">
                        <!-- 外观 -->
                        <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                            <Border Width="3" Height="13" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Static res:Strings.Settings_Appearance}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="18,0" MinHeight="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconChip}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoPalette}" Width="18" Height="18"
                                              Stretch="Uniform" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" MinWidth="150" Margin="14,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.Settings_AppIcon}" />
                                        <TextBlock Style="{StaticResource RowHint}" Margin="0,3,0,0"
                                                   Text="{x:Static res:Strings.Settings_AppIconHint}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Preview only: the artwork is recognisable on its
                                             own and the icon name was a second label for the
                                             same thing, so it is gone. The frame is large
                                             enough to tell the ten poses and colours apart.
                                             The image is BrandMark, the same element the
                                             device page's RefreshBrandMarks keeps in sync. -->
                                        <Border Width="48" Height="48" CornerRadius="13" Margin="0,0,14,0"
                                                Background="{DynamicResource CardElevatedBrush}"
                                                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                                            <Image x:Name="BrandMark" Width="40" Height="40"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Border>
                                        <Button Content="{x:Static res:Strings.Settings_AppIconCycle}" MinWidth="72" Click="CycleIcon_Click"
                                                ToolTip="{x:Static res:Strings.Settings_AppIconCycleTooltip}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Margin="18,0" MinHeight="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconChip}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoTheme}" Width="18" Height="18"
                                              Stretch="Uniform" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" MinWidth="150" Margin="14,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.Settings_Theme}" />
                                        <TextBlock Style="{StaticResource RowHint}" Margin="0,3,0,0"
                                                   Text="{x:Static res:Strings.Settings_ThemeHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SegmentTrack}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegChoice}"
                                                         Content="{x:Static res:Strings.Settings_ThemeSystem}" GroupName="theme"
                                                         Checked="Theme_Checked" />
                                            <RadioButton x:Name="ThemeLight" Style="{StaticResource SegChoice}"
                                                         Content="{x:Static res:Strings.Settings_ThemeLight}" GroupName="theme"
                                                         Checked="Theme_Checked" />
                                            <RadioButton x:Name="ThemeDark" Style="{StaticResource SegChoice}"
                                                         Content="{x:Static res:Strings.Settings_ThemeDark}" GroupName="theme"
                                                         Checked="Theme_Checked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 启动与连接 -->
                        <StackPanel Orientation="Horizontal" Margin="2,22,0,10">
                            <Border Width="3" Height="13" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Static res:Strings.Settings_StartupGroup}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCard}">
                            <StackPanel>
                                <Grid Margin="18,0" MinHeight="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconChip}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoPower}" Width="18" Height="18"
                                              Stretch="Uniform" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" MinWidth="150" Margin="14,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.Settings_Startup}" />
                                        <TextBlock Style="{StaticResource RowHint}" Margin="0,3,0,0"
                                                   Text="{x:Static res:Strings.Settings_StartupHint}" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Style="{StaticResource SegmentTrack}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="StartDevices" Style="{StaticResource SegChoice}"
                                                         Content="{x:Static res:Strings.Settings_StartPageDevices}" GroupName="start"
                                                         Checked="StartPage_Checked" />
                                            <RadioButton x:Name="StartLast" Style="{StaticResource SegChoice}"
                                                         Content="{x:Static res:Strings.Settings_StartPageLastDevice}" GroupName="start"
                                                         Checked="StartPage_Checked" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource RowDivider}" />
                                <Grid Margin="18,0" MinHeight="68">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconChip}" VerticalAlignment="Center">
                                        <Path Data="{StaticResource IcoBell}" Width="18" Height="18"
                                              Stretch="Uniform" StrokeThickness="1.6"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" MinWidth="150" Margin="14,0,18,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.Settings_Notify}" />
                                        <TextBlock Style="{StaticResource RowHint}" Margin="0,3,0,0"
                                                   Text="{x:Static res:Strings.Settings_NotifyHint}" />
                                    </StackPanel>
                                    <CheckBox x:Name="NotifyToggle" Grid.Column="2"
                                              Style="{StaticResource SwitchToggle}"
                                              VerticalAlignment="Center"
                                              Click="Notify_Click"
                                              AutomationProperties.Name="{x:Static res:Strings.Settings_NotifyAutomationName}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 数据 -->
                        <StackPanel Orientation="Horizontal" Margin="2,22,0,10">
                            <Border Width="3" Height="13" CornerRadius="1.5"
                                    Background="{DynamicResource AccentBrush}"
                                    VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource GroupLabel}" Text="{x:Static res:Strings.Settings_Data}"
                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Style="{StaticResource GroupCard}">
                            <Grid Margin="18,0" MinHeight="68">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconChip}" VerticalAlignment="Center">
                                    <Path Data="{StaticResource IcoBroom}" Width="18" Height="18"
                                          Stretch="Uniform" StrokeThickness="1.6"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="{DynamicResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1" MinWidth="150" Margin="14,0,18,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource RowTitle}" Text="{x:Static res:Strings.Settings_ClearSiteData}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,3,0,0"
                                               Text="{x:Static res:Strings.Settings_ClearSiteDataHint}" />
                                </StackPanel>
                                <Button Grid.Column="2" MinWidth="88" Content="{x:Static res:Strings.Common_Clear}"
                                        VerticalAlignment="Center"
                                        Click="ClearSiteData_Click"
                                        ToolTip="{x:Static res:Strings.Settings_ClearTooltip}" />
                            </Grid>
                        </Border>

                        <!-- Product footer: version and the portable promise, on the same
                             accent-tinted band as the brand, so "about" does not need a
                             sixth identical card. -->
                        <Border Margin="0,20,0,0" Padding="18,14" CornerRadius="14"
                                Background="{DynamicResource AccentSoftBrush}"
                                BorderBrush="{DynamicResource AccentSoftBorderBrush}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- The whale is the product mark here, so it is set at a
                                     size the eye reads as one: 38 DIP inside a 14+30 row
                                     left it looking like a bullet point. -->
                                <Image Source="pack://siteoforigin:,,,/icons/brand-whale.png"
                                       Width="40" Height="40" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <StackPanel Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="VersionText" FontSize="12.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Style="{StaticResource RowHint}" Margin="0,3,0,0"
                                               Text="{x:Static res:Strings.Settings_PortableHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource EyebrowText}"
                                               Text="PORTABLE" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <!-- The failure copy for an incompatible protocol tells the
                                         user to update from here, so this row has to exist. -->
                                    <Button x:Name="CheckUpdateButton" Content="{x:Static res:Strings.Update_Check}" MinWidth="88"
                                            Click="CheckUpdate_Click"
                                            ToolTip="{x:Static res:Strings.Update_CheckTooltip}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="UpdateResultText" Margin="18,8,18,0" FontSize="12"
                                   TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <!-- Update transfer row: only visible while a download, checksum or
                             installer launch is running, so the footer stays quiet at rest.
                             The bar takes the accent fill and the page's 3 DIP radius
                             instead of the stock WPF chrome. -->
                        <StackPanel x:Name="UpdateProgressPanel" Orientation="Horizontal"
                                    Margin="18,10,18,0" Visibility="Collapsed">
                            <ProgressBar x:Name="UpdateProgressBar" Width="200" Height="6"
                                         Minimum="0" Maximum="100" Value="0"
                                         AutomationProperties.Name="{x:Static res:Strings.Update_ProgressAccessibility}"
                                         VerticalAlignment="Center" BorderThickness="0"
                                         Background="{DynamicResource SurfaceAltBrush}"
                                         Foreground="{DynamicResource AccentBrush}">
                                <ProgressBar.Template>
                                    <ControlTemplate TargetType="ProgressBar">
                                        <Border CornerRadius="3" ClipToBounds="True"
                                                Background="{TemplateBinding Background}">
                                            <Grid>
                                                <Rectangle x:Name="PART_Track" />
                                                <Rectangle x:Name="PART_Indicator" RadiusX="3"
                                                           RadiusY="3" HorizontalAlignment="Left"
                                                           Fill="{TemplateBinding Foreground}" />
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ProgressBar.Template>
                            </ProgressBar>
                            <TextBlock x:Name="UpdateProgressText" Margin="10,0,0,0" FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <Button x:Name="CancelUpdateButton" Content="{x:Static res:Strings.Common_Cancel}" MinWidth="0"
                                    Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                    Click="CancelUpdate_Click"
                                    ToolTip="{x:Static res:Strings.Update_CancelDownloadTooltip}" />
                        </StackPanel>
                        <!-- Escape hatch for every failure path: the messages name this
                             page so the user is never stuck on a broken download. -->
                        <Button x:Name="ManualUpdateButton" Content="{x:Static res:Strings.Update_OpenDownloadPage}" MinWidth="0"
                                Style="{StaticResource GhostButton}"
                                Margin="18,4,18,0" HorizontalAlignment="Left"
                                Visibility="Collapsed" Click="OpenReleases_Click"
                                ToolTip="{x:Static res:Strings.Update_OpenDownloadPageTooltip}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Rail: the client's navigation, not a strip bolted to the right edge.
                 A brand mark anchors the top, each destination carries a label, and the
                 selected one gets an accent pill plus a 3px marker. RadioButtons give
                 the selection to XAML triggers and to a screen reader at once. -->
            <Border Grid.Column="1" Width="76"
                    Background="{DynamicResource RailBrush}"
                    BorderBrush="{DynamicResource RailBorderBrush}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- The whale from the shared launcher artwork set: the one brand
                         element on this page that is never replaced by content. At 26 DIP
                         inside a 76 DIP rail it read as stray punctuation, so it is set
                         to 44 DIP, which keeps 16 DIP of air on either side. -->
                    <Image Grid.Row="0" Source="pack://siteoforigin:,,,/icons/brand-whale.png"
                           Width="44" Height="44" Margin="0,22,0,0"
                           HorizontalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />

                    <Border Grid.Row="1" Height="1" Margin="16,20,16,0"
                            Background="{DynamicResource DividerBrush}" />

                    <StackPanel Grid.Row="2" Margin="0,14,0,0">
                        <RadioButton x:Name="DevicesRailButton" Style="{StaticResource RailItem}"
                                     GroupName="railNav" IsChecked="True"
                                     Tag="{StaticResource IconDevices}" Content="{x:Static res:Strings.Nav_Devices}"
                                     Click="SettingsBack_Click"
                                     AutomationProperties.Name="{x:Static res:Strings.Nav_DeviceList}" ToolTip="{x:Static res:Strings.Nav_DeviceList}" />
                        <RadioButton x:Name="SettingsRailButton" Style="{StaticResource RailItem}"
                                     GroupName="railNav"
                                     Tag="{StaticResource IconSettings}" Content="{x:Static res:Strings.Nav_Settings}"
                                     Click="SettingsOpen_Click"
                                     AutomationProperties.Name="{x:Static res:Strings.Nav_Settings}" ToolTip="{x:Static res:Strings.Nav_Settings}" />
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Undo strip: shown for a few seconds after a delete, overlaying the
                 bottom of the page so it never reflows the list it refers to. -->
            <Border x:Name="UndoBar" Grid.ColumnSpan="2" Style="{StaticResource UndoBarShell}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UndoText" VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource PrimaryTextBrush}" />
                    <Button x:Name="UndoButton" Margin="16,0,0,0" MinWidth="72" MinHeight="36"
                            Content="{x:Static res:Strings.DeviceList_UndoAction}" Click="UndoDelete_Click"
                            Foreground="{DynamicResource AccentBrush}"
                            ToolTip="{x:Static res:Strings.DeviceList_UndoTooltip}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
