<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DshMobile.Win</AssemblyName>
    <RootNamespace>DshMobile.Win</RootNamespace>
    <!-- Portable self-contained build: keep the win-x64 assets in project.assets.json -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Same launcher icon as the Android app (apps/mobile/.../mipmap-xxxhdpi/ic_launcher.png). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- Pinned upstream iroh sidecar (sha256 in sidecar/manifest.json).
       MainWindow looks for the exe next to the app binary, so publish it there. -->
  <ItemGroup>
    <None Update="sidecar\dsh-mobile-iroh-host-win32-x64.exe"
          Link="dsh-mobile-iroh-host-win32-x64.exe"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
