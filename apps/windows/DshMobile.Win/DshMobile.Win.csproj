<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DshMobile.Win</AssemblyName>
    <RootNamespace>DshMobile.Win</RootNamespace>
    <!-- First published build. The client ships on its own track, so its version is
         independent of the plugin (package.json) and of the iroh sidecar pin. -->
    <Version>0.1.2-alpha</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.2.0</FileVersion>
    <InformationalVersion>0.1.2-alpha</InformationalVersion>
    <Product>DSH Mobile</Product>
    <Company>DSH Mobile contributors</Company>
    <Copyright>Copyright (c) DSH Mobile contributors</Copyright>
    <!-- Portable self-contained build: keep the win-x64 assets in project.assets.json -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Same launcher icon as the Android app (apps/mobile/.../mipmap-xxxhdpi/ic_launcher.png). -->
    <ApplicationIcon>app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3124.44" />
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- User-visible strings. Resources/Strings.resx holds the Chinese defaults; the
       accessor (Resources/Strings.Designer.cs) is written by hand rather than emitted by
       ResXFileCodeGenerator, so a build does not depend on Visual Studio or a designer
       round-trip. The SDK already embeds every .resx under the project root, but the
       logical name is pinned here (note the required .resources suffix) so the
       ResourceManager lookup in the accessor cannot drift if RootNamespace or the
       folder layout ever changes. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\Strings.resx">
      <LogicalName>DshMobile.Win.Resources.Strings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Launcher artwork the user can switch between. These are the same assets the
       Android app ships, converted to multi-size ICO; they must land in the
       published folder because the icon picker reads them at runtime.
       The PNGs are the shell's brand artwork (page header avatar, rail mark); they
       are PNG rather than ICO because the WPF ICO decoder picks a small frame and
       the scaled-up result looked soft next to the vector glyphs. -->
  <ItemGroup>
    <Content Include="icons\*.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Pure-logic unit tests live in a separate project; expose internals only to it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="DshMobile.Win.Tests" />
  </ItemGroup>

  <!-- UseWindowsForms is only for NotifyIcon balloons (fully qualified in
       code). Drop its implicit namespace so WPF types stay unambiguous. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- The iroh sidecar is intentionally NOT packaged (see sidecar/manifest.json):
       SidecarProvisioner acquires the pinned official artifact on first use and
       verifies byte count + SHA-256 before every launch. -->

  <!-- A portable package is handed to users as a folder, so it must not carry the
       debug symbols: they add bulk and expose the build machine's source paths.
       Symbols stay in bin/ for debugging a build; only the published folder drops
       them. The XML documents beside the WebView2 reference are kept — they are
       part of that package's documentation, not of ours. -->
  <Target Name="RemoveSymbolsFromPublish" AfterTargets="Publish">
    <ItemGroup>
      <PublishedSymbols Include="$(PublishDir)**\*.pdb" />
    </ItemGroup>
    <Delete Files="@(PublishedSymbols)" />
  </Target>
</Project>
