<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- DSH voice input requests echo cancellation. Chromium may need this normal
         permission for communication-audio handling in WebView; Android grants it
         at install, while RECORD_AUDIO still controls microphone access. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:name=".MobileApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize" />
        <!-- MainActivity stays exported for existing explicit launcher shortcuts and
             notification intents. New launcher entries use the selectable aliases. -->
        <!-- One selected alias remains enabled after a switch. The default mascot
             ships enabled; optional whale aliases ship disabled. -->
        <activity-alias
            android:name=".LauncherWhaleGirl"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOfficialWhale"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_whale"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_whale"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOfficialWhaleDark"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_whale_dark"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_whale_dark"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOfficialWhaleTeal"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_whale_teal"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_whale_teal"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOfficialWhaleMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_whale_mono"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_whale_mono"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOfficialWhaleBlack"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_whale_black"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_whale_black"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherOfficialWhaleWhite"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_whale_white"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_whale_white"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity
            android:name=".ScanActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
